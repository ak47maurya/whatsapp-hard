<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsApp Groups — AK Automations</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="user-layout">
  <nav class="navbar navbar-expand-lg navbar-gold fixed-top shadow-sm">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/manager/dashboard">
        <span class="d-inline-flex align-items-center justify-content-center" style="width:38px;height:38px;border-radius:10px;background:#fff;color:var(--gold-dark);font-weight:800;">AK</span>
        <span>AK Automations</span>
      </a>
      <div class="d-flex align-items-center gap-3 ms-auto">
        <span class="text-white-50 small d-none d-md-inline">Welcome, <strong><%= user.username %></strong></span>
        <a class="btn btn-light btn-sm rounded-pill px-3 d-none d-md-inline-flex" href="/manager/logout"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout</a>
        <button class="navbar-toggler d-lg-none" type="button" id="userSidebarToggle" aria-label="Open navigation menu" aria-controls="userSidebar" aria-expanded="false">
          <i class="fa-solid fa-bars text-white"></i>
        </button>
      </div>
    </div>
  </nav>

  <div class="user-sidebar-overlay" id="userSidebarOverlay"></div>
  <div class="container-fluid user-app">
    <div class="row gx-0">
      <nav class="col-md-3 col-lg-2 sidebar" id="userSidebar" aria-label="Main navigation">
        <div class="position-sticky pt-4 px-3">
          <div class="text-center mb-4 pb-3 border-bottom">
            <div class="d-inline-flex align-items-center justify-content-center mx-auto mb-2" style="width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,var(--gold-light),var(--gold));color:#fff;font-weight:800;font-size:1.25rem;">AK</div>
            <h6 class="mb-0 fw-bold text-uppercase small">User Panel</h6>
          </div>
          <%- include('partials/sidebar-navigation', { activePage: 'groups' }) %>
        </div>
      </nav>

      <main class="col-md-9 col-lg-10 px-3 px-md-4 py-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pb-3 mb-4 border-bottom">
          <div>
            <h2 class="fw-bold text-dark mb-1">WhatsApp Groups</h2>
            <small class="text-muted">Apne connected account ke groups, members aur group-wise contacts export karein.</small>
          </div>
          <span class="badge bg-light text-dark fs-6" id="groupCount">0 groups</span>
        </div>

        <section class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-end">
              <div class="col-md-6">
                <label for="groupInstance" class="form-label fw-semibold">WhatsApp instance</label>
                <select class="form-select" id="groupInstance">
                  <option value="">Instance select karein</option>
                  <% (user.insdetails || []).forEach(instance => { %>
                    <option value="<%= instance.Token_Id %>"><%= instance.Token_Id %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6 d-flex gap-2">
                <button class="btn btn-success rounded-pill px-4" id="loadGroups" type="button">
                  <i class="fa-solid fa-arrows-rotate me-1"></i> Load groups
                </button>
                <input class="form-control" id="groupSearch" type="search" placeholder="Group ya member search karein" disabled>
              </div>
            </div>
            <div class="small text-muted mt-3" id="groupStatus" role="status">Instance select karke groups load karein.</div>
          </div>
        </section>

        <div class="row g-3" id="groupList"></div>
        <%- include('partials/footer') %>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/user-navigation.js"></script>
  <script>
    let groups = [];
    const groupList = document.getElementById('groupList');
    const groupStatus = document.getElementById('groupStatus');

    function downloadGroupContacts(participants, subject) {
      const numbers = Array.from(new Set(participants.map(participant => {
        const phone = participant.phoneNumber ||
          (participant.id && participant.id.endsWith('@s.whatsapp.net') ? participant.id : '');
        return String(phone).replace(/\D/g, '');
      }).filter(Boolean)));
      if (!numbers.length) {
        groupStatus.textContent = 'Is group ke liye export karne layak mobile numbers nahi mile.';
        return;
      }
      const csv = `Mobile Number\r\n${numbers.join('\r\n')}`;
      const blob = new Blob(['\uFEFF', csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const filename = (subject || 'whatsapp-group').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'whatsapp-group';
      link.href = url;
      link.download = `${filename}-contacts-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.append(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function renderGroups() {
      const query = document.getElementById('groupSearch').value.trim().toLowerCase();
      const filtered = groups.filter(({ id, group }) => {
        const participants = Array.isArray(group.participants) ? group.participants : [];
        return [group.subject, id, ...participants.flatMap(participant => [participant.id, participant.phoneNumber])]
          .filter(Boolean).join(' ').toLowerCase().includes(query);
      });
      groupList.replaceChildren();
      document.getElementById('groupCount').textContent = `${filtered.length} of ${groups.length} groups`;
      if (!filtered.length) {
        groupStatus.textContent = groups.length ? 'Search se match karta koi group nahi mila.' : 'Is instance par koi group nahi mila.';
        return;
      }
      groupStatus.textContent = '';

      filtered.forEach(({ id, group }) => {
        const participants = Array.isArray(group.participants) ? group.participants : [];
        const column = document.createElement('div');
        column.className = 'col-12 col-xl-6';
        const card = document.createElement('article');
        card.className = 'card border-0 shadow-sm rounded-4 h-100';
        const body = document.createElement('div');
        body.className = 'card-body p-3 p-md-4';
        const heading = document.createElement('div');
        heading.className = 'd-flex justify-content-between align-items-start gap-2';
        const title = document.createElement('h5');
        title.className = 'fw-bold text-break mb-1';
        title.textContent = group.subject || 'Unnamed group';
        const badge = document.createElement('span');
        badge.className = 'badge bg-light text-dark flex-shrink-0';
        badge.textContent = `${group.size ?? participants.length} members`;
        heading.append(title, badge);
        body.append(heading);
        const groupId = document.createElement('div');
        groupId.className = 'small text-muted text-break mb-3';
        groupId.textContent = id;
        body.append(groupId);

        const exportButton = document.createElement('button');
        exportButton.className = 'btn btn-outline-success btn-sm rounded-pill px-3 mb-3';
        exportButton.type = 'button';
        exportButton.innerHTML = '<i class="fa-solid fa-file-csv me-1"></i> Export this group contacts';
        exportButton.addEventListener('click', () => downloadGroupContacts(participants, group.subject));
        body.append(exportButton);

        const details = document.createElement('details');
        const summary = document.createElement('summary');
        summary.className = 'text-success small fw-semibold';
        summary.textContent = 'Members dekhein';
        details.append(summary);
        const members = document.createElement('ul');
        members.className = 'list-group list-group-flush mt-2';
        if (!participants.length) {
          const empty = document.createElement('li');
          empty.className = 'list-group-item px-0 small text-muted';
          empty.textContent = 'Member details available nahi hain.';
          members.append(empty);
        } else {
          participants.forEach(participant => {
            const item = document.createElement('li');
            item.className = 'list-group-item px-0 py-2 d-flex justify-content-between align-items-start gap-2';
            const number = document.createElement('span');
            number.className = 'small text-break';
            number.textContent = participant.phoneNumber || participant.id || 'Unknown member';
            const role = document.createElement('span');
            role.className = `badge ${participant.admin ? 'bg-warning text-dark' : 'bg-light text-dark'} flex-shrink-0`;
            role.textContent = participant.admin === 'superadmin' ? 'Super admin' : participant.admin === 'admin' ? 'Admin' : 'Member';
            item.append(number, role);
            members.append(item);
          });
        }
        details.append(members);
        body.append(details);
        card.append(body);
        column.append(card);
        groupList.append(column);
      });
      groupStatus.textContent = `${filtered.length} groups shown`;
    }

    async function loadGroups() {
      const tokenId = document.getElementById('groupInstance').value;
      const button = document.getElementById('loadGroups');
      if (!tokenId) {
        groupStatus.textContent = 'Pehle WhatsApp instance select karein.';
        return;
      }
      button.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Loading...';
      groupStatus.textContent = 'Groups load ho rahe hain...';
      try {
        const response = await fetch(`/manager/groups/data?${new URLSearchParams({ tokenId })}`);
        const result = await response.json();
        if (!response.ok || result.error) throw new Error(result.message || 'Groups load nahi ho sake.');
        groups = Object.entries(result.data || {}).map(([id, group]) => ({ id, group }));
        document.getElementById('groupSearch').disabled = false;
        renderGroups();
      } catch (error) {
        groups = [];
        groupList.replaceChildren();
        document.getElementById('groupCount').textContent = '0 groups';
        groupStatus.textContent = error.message || 'Groups load karte waqt error aaya.';
      } finally {
        button.disabled = false;
        button.innerHTML = '<i class="fa-solid fa-arrows-rotate me-1"></i> Load groups';
      }
    }

    document.getElementById('loadGroups').addEventListener('click', loadGroups);
    document.getElementById('groupSearch').addEventListener('input', renderGroups);
  </script>
</body>
</html>
