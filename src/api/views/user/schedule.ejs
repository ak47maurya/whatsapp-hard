<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Scheduled Messages — AK Automations</title>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
        />
        <link rel="stylesheet" href="/css/styles.css" />
    </head>
    <body class="user-layout">
        <nav class="navbar navbar-expand-lg navbar-gold fixed-top shadow-sm">
            <div class="container-fluid px-4">
                <a
                    class="navbar-brand d-flex align-items-center gap-2"
                    href="/manager/dashboard"
                >
                    <span
                        class="d-inline-flex align-items-center justify-content-center"
                        style="
                            width: 38px;
                            height: 38px;
                            border-radius: 10px;
                            background: #fff;
                            color: var(--gold-dark);
                            font-weight: 800;
                        "
                        >AK</span
                    >
                    <span>AK Automations</span>
                </a>
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <span class="text-white-50 small d-none d-md-inline"
                        >Welcome, <strong><%= user.username %></strong></span
                    >
                    <a
                        class="btn btn-light btn-sm rounded-pill px-3 d-none d-md-inline-flex"
                        href="/manager/logout"
                        ><i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout</a
                    >
                    <button
                        class="navbar-toggler d-lg-none"
                        type="button"
                        id="userSidebarToggle"
                        aria-label="Open navigation menu"
                        aria-controls="userSidebar"
                        aria-expanded="false"
                    >
                        <i class="fa-solid fa-bars text-white"></i>
                    </button>
                </div>
            </div>
        </nav>

        <div class="user-sidebar-overlay" id="userSidebarOverlay"></div>
        <div class="container-fluid user-app">
            <div class="row gx-0">
                <nav
                    class="col-md-3 col-lg-2 sidebar"
                    id="userSidebar"
                    aria-label="Main navigation"
                >
                    <div class="position-sticky pt-4 px-3">
                        <div class="text-center mb-4 pb-3 border-bottom">
                            <div
                                class="d-inline-flex align-items-center justify-content-center mx-auto mb-2"
                                style="
                                    width: 50px;
                                    height: 50px;
                                    border-radius: 12px;
                                    background: linear-gradient(
                                        135deg,
                                        var(--gold-light),
                                        var(--gold)
                                    );
                                    color: #fff;
                                    font-weight: 800;
                                    font-size: 1.25rem;
                                "
                            >
                                AK
                            </div>
                            <h6 class="mb-0 fw-bold text-uppercase small">
                                User Panel
                            </h6>
                        </div>
                        <%- include('partials/sidebar-navigation', { activePage: 'schedule' }) %>
                    </div>
                </nav>

                <main class="col-md-9 col-lg-10 px-3 px-md-4 py-4">
                    <div
                        class="d-flex justify-content-between flex-wrap align-items-center pb-2 mb-4 border-bottom"
                    >
                        <div>
                            <h2 class="fw-bold text-dark mb-1">
                                Scheduled Messages
                            </h2>
                            <small class="text-muted"
                                >Bulk text ya media message schedule karein aur
                                delivery analytics dekhein.</small
                            >
                        </div>
                        <button
                            class="btn btn-outline-success rounded-pill mt-2 mt-md-0"
                            type="button"
                            onclick="loadCampaigns()"
                        >
                            <i class="fa-solid fa-arrows-rotate me-1"></i>
                            Refresh
                        </button>
                    </div>

                    <div class="alert alert-info py-2" id="planLimitsNotice">
                        Plan limits load ho rahe hain...
                    </div>
                    <% if (user.planStatus === 'Expired' &&
                    !user.role.includes('admin')) { %>
                    <div class="alert alert-danger">
                        Aapka plan expire ho gaya hai. Schedule create ya send
                        karne se pehle plan renew karein.
                    </div>
                    <% } %>

                    <section class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-3 p-md-4">
                            <h4 class="fw-bold mb-3" id="scheduleFormTitle">
                                <i
                                    class="fa-solid fa-calendar-plus text-success me-2"
                                ></i
                                >New Schedule
                            </h4>
                            <form id="scheduleForm">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label
                                            for="scheduleInstance"
                                            class="form-label fw-semibold"
                                            >WhatsApp instance</label
                                        >
                                        <select
                                            class="form-select"
                                            id="scheduleInstance"
                                            required
                                        >
                                            <option value="">
                                                Instance select karein
                                            </option>
                                            <% (user.insdetails ||
                                            []).forEach(instance => { %>
                                            <option
                                                value="<%= instance.Token_Id %>"
                                            >
                                                <%= instance.Token_Id %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label
                                            for="scheduleAt"
                                            class="form-label fw-semibold"
                                            >Send date &amp; time</label
                                        >
                                        <input
                                            class="form-control"
                                            id="scheduleAt"
                                            type="datetime-local"
                                            required
                                        />
                                    </div>
                                    <div class="col-md-6">
                                        <label
                                            for="scheduleType"
                                            class="form-label fw-semibold"
                                            >Message type</label
                                        >
                                        <select
                                            class="form-select"
                                            id="scheduleType"
                                        >
                                            <option value="text">
                                                Text message
                                            </option>
                                            <option value="image">Image</option>
                                            <option value="video">Video</option>
                                            <option value="audio">Audio</option>
                                            <option value="document">
                                                Document
                                            </option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label
                                            for="scheduleNumbers"
                                            class="form-label fw-semibold"
                                            >Mobile numbers (comma
                                            separated)</label
                                        >
                                        <textarea
                                            class="form-control"
                                            id="scheduleNumbers"
                                            rows="2"
                                            placeholder="919876543210, 918765432109"
                                            required
                                        ></textarea>
                                        <div class="form-text">
                                            Country code ke saath number
                                            likhein. Maximum 500 recipients per
                                            schedule; sirf opted-in contacts ko
                                            message bhejein.
                                        </div>
                                    </div>
                                    <div class="col-12" id="scheduleTextField">
                                        <label
                                            for="scheduleMessage"
                                            class="form-label fw-semibold"
                                            >Message</label
                                        >
                                        <textarea
                                            class="form-control"
                                            id="scheduleMessage"
                                            rows="3"
                                            maxlength="4000"
                                            placeholder="Apna message likhein"
                                        ></textarea>
                                    </div>
                                    <div
                                        class="col-md-8 d-none"
                                        id="scheduleMediaFields"
                                    >
                                        <label
                                            for="scheduleUrl"
                                            class="form-label fw-semibold"
                                            >Media URL</label
                                        >
                                        <input
                                            class="form-control"
                                            id="scheduleUrl"
                                            type="url"
                                            placeholder="https://example.com/file"
                                        />
                                    </div>
                                    <div
                                        class="col-12 d-none"
                                        id="scheduleCaptionField"
                                    >
                                        <label
                                            for="scheduleCaption"
                                            class="form-label fw-semibold"
                                            >Caption (optional)</label
                                        >
                                        <textarea
                                            class="form-control"
                                            id="scheduleCaption"
                                            rows="3"
                                            maxlength="1000"
                                            placeholder="Media caption"
                                        ></textarea>
                                    </div>
                                    <div class="col-12">
                                        <button
                                            class="btn btn-success rounded-pill px-4"
                                            id="scheduleSubmit"
                                            type="submit"
                                        >
                                            <i
                                                class="fa-solid fa-calendar-check me-1"
                                            ></i>
                                            Schedule message
                                        </button>
                                        <button
                                            class="btn btn-outline-secondary rounded-pill px-4 d-none"
                                            id="cancelScheduleEdit"
                                            type="button"
                                            onclick="cancelScheduleEdit()"
                                        >
                                            Cancel edit
                                        </button>
                                        <span class="text-muted small ms-2"
                                            >Device scheduled time par offline
                                            hua to online aane par sending start
                                            hogi.</span
                                        >
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>

                    <% if (false) { %>
                    <section
                        class="card border-0 shadow-sm rounded-4 mb-4"
                        id="templateScheduler"
                    >
                        <div class="card-body p-3 p-md-4">
                            <h4 class="fw-bold mb-1">
                                <i
                                    class="fa-solid fa-file-lines text-success me-2"
                                ></i
                                >Message templates
                            </h4>
                            <p class="text-muted mb-3">
                                Pehle message template banayein. Variables ko
                                <code>{{name}}</code> format mein likhein.
                            </p>
                            <form
                                id="templateForm"
                                class="border rounded-3 p-3 mb-4"
                            >
                                <input type="hidden" id="templateId" />
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label
                                            for="templateName"
                                            class="form-label fw-semibold"
                                            >Template name</label
                                        >
                                        <input
                                            class="form-control"
                                            id="templateName"
                                            maxlength="100"
                                            required
                                            placeholder="Order update"
                                        />
                                    </div>
                                    <div class="col-md-8">
                                        <label
                                            for="templateBody"
                                            class="form-label fw-semibold"
                                            >Message text</label
                                        >
                                        <textarea
                                            class="form-control"
                                            id="templateBody"
                                            rows="3"
                                            maxlength="4000"
                                            required
                                            placeholder="Hello {{name}}, your order {{order_id}} is ready."
                                        ></textarea>
                                        <div class="form-text">
                                            Variable names letters se shuru hon;
                                            letters, numbers aur underscore use
                                            kar sakte hain.
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button
                                            class="btn btn-success rounded-pill px-4"
                                            id="templateSubmit"
                                            type="submit"
                                        >
                                            Save template
                                        </button>
                                        <button
                                            class="btn btn-outline-secondary rounded-pill px-4 d-none"
                                            id="cancelTemplateEdit"
                                            type="button"
                                        >
                                            Cancel edit
                                        </button>
                                    </div>
                                </div>
                            </form>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Template</th>
                                            <th>Variables / Excel columns</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="templateTableBody">
                                        <tr>
                                            <td
                                                colspan="3"
                                                class="text-center text-muted py-3"
                                            >
                                                Templates load ho rahe hain...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>

                    <section class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-3 p-md-4">
                            <h4 class="fw-bold mb-1" id="templateScheduleTitle">
                                <i
                                    class="fa-solid fa-calendar-plus text-success me-2"
                                ></i
                                >Template Scheduler
                            </h4>
                            <p class="text-muted">
                                Excel browser mein hi read/export hogi. Server
                                ko sirf validated JSON recipients milenge.
                            </p>
                            <form id="templateScheduleForm">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label
                                            for="templateScheduleInstance"
                                            class="form-label fw-semibold"
                                            >WhatsApp instance</label
                                        >
                                        <select
                                            class="form-select"
                                            id="templateScheduleInstance"
                                            required
                                        >
                                            <option value="">
                                                Instance select karein
                                            </option>
                                            <% (user.insdetails ||
                                            []).forEach(instance => { %>
                                            <option
                                                value="<%= instance.Token_Id %>"
                                            >
                                                <%= instance.Token_Id %>
                                            </option>
                                            <% }) %>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label
                                            for="scheduleTemplate"
                                            class="form-label fw-semibold"
                                            >Message template</label
                                        >
                                        <select
                                            class="form-select"
                                            id="scheduleTemplate"
                                            required
                                        >
                                            <option value="">
                                                Pehle template banayein ya
                                                select karein
                                            </option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label
                                            for="templateScheduleAt"
                                            class="form-label fw-semibold"
                                            >Send date &amp; time</label
                                        >
                                        <input
                                            class="form-control"
                                            id="templateScheduleAt"
                                            type="datetime-local"
                                            required
                                        />
                                    </div>
                                    <div class="col-md-6">
                                        <label
                                            for="templateSpreadsheet"
                                            class="form-label fw-semibold"
                                            >Excel recipient file (.xlsx)</label
                                        >
                                        <input
                                            class="form-control"
                                            id="templateSpreadsheet"
                                            type="file"
                                            accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                                            required
                                        />
                                        <div class="form-text">
                                            Excel ko browser mein read kiya
                                            jayega, upload server par nahi hoga.
                                            Exported file ke mobile aur
                                            {{variable}} columns use karein. Max
                                            500 opted-in contacts.
                                        </div>
                                        <div
                                            class="form-text"
                                            id="spreadsheetStatus"
                                            aria-live="polite"
                                        ></div>
                                    </div>
                                    <div class="col-12">
                                        <div
                                            class="alert alert-light border mb-0"
                                            id="templatePreview"
                                        >
                                            Template preview select karne par
                                            yahan dikhega.
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button
                                            class="btn btn-success rounded-pill px-4"
                                            id="templateScheduleSubmit"
                                            type="submit"
                                        >
                                            <i
                                                class="fa-solid fa-calendar-check me-1"
                                            ></i>
                                            Schedule template messages
                                        </button>
                                        <button
                                            class="btn btn-outline-secondary rounded-pill px-4 d-none"
                                            id="cancelTemplateScheduleEdit"
                                            type="button"
                                        >
                                            Cancel edit
                                        </button>
                                        <span class="text-muted small ms-2"
                                            >Scheduled time par instance offline
                                            ho to online aane par sending start
                                            hogi.</span
                                        >
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>

                    <section class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-3 p-md-4">
                            <div
                                class="d-flex justify-content-between align-items-center mb-3"
                            >
                                <h4 class="fw-bold mb-0">Template schedules</h4>
                                <button
                                    class="btn btn-outline-success btn-sm rounded-pill"
                                    type="button"
                                    id="refreshTemplateSchedules"
                                >
                                    Refresh
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Scheduled time</th>
                                            <th>Template</th>
                                            <th>Instance</th>
                                            <th>Recipients</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="templateScheduleTableBody">
                                        <tr>
                                            <td
                                                colspan="6"
                                                class="text-center text-muted py-3"
                                            >
                                                Template schedules load ho rahe
                                                hain...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                    <% } %>

                    <section class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-3 p-md-4">
                            <div
                                class="d-flex justify-content-between align-items-center mb-3"
                            >
                                <h4 class="fw-bold mb-0">
                                    Schedules &amp; delivery analytics
                                </h4>
                                <span
                                    class="badge bg-success rounded-pill"
                                    id="scheduleTotal"
                                    >0 schedules</span
                                >
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th>Scheduled time</th>
                                            <th>Instance</th>
                                            <th>Type</th>
                                            <th>Recipients</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="scheduleTableBody">
                                        <tr>
                                            <td
                                                colspan="6"
                                                class="text-center text-muted py-4"
                                            >
                                                Schedules load ho rahe hain...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                    <%- include('partials/footer') %>
                </main>
            </div>
        </div>

        <div
            class="modal fade"
            id="scheduleAnalyticsModal"
            tabindex="-1"
            aria-labelledby="analyticsTitle"
            aria-hidden="true"
        >
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content border-0 rounded-4">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title fw-bold" id="analyticsTitle">
                                Delivery analytics
                            </h5>
                            <div
                                class="small text-muted"
                                id="analyticsMeta"
                            ></div>
                        </div>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                        ></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2 mb-3" id="analyticsSummary"></div>
                        <div class="bg-light rounded-3 p-3 mb-3">
                            <div class="fw-semibold mb-1">Message details</div>
                            <div
                                class="small text-break"
                                id="analyticsMessage"
                            ></div>
                        </div>
                        <div class="table-responsive">
                            <table
                                class="table table-sm table-hover align-middle"
                            >
                                <thead>
                                    <tr>
                                        <th>Mobile number</th>
                                        <th>Status</th>
                                        <th>Sent at / Failure reason</th>
                                    </tr>
                                </thead>
                                <tbody id="analyticsRecipients"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
        <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
        <script src="/js/user-navigation.js"></script>
        <script>
            const scheduleType = document.getElementById('scheduleType')
            const scheduleForm = document.getElementById('scheduleForm')
            const scheduleModal = new bootstrap.Modal(
                document.getElementById('scheduleAnalyticsModal')
            )
            let editingCampaignId = null
            let maxRecipientsPerCampaign = 500
            const stateClasses = {
                scheduled: 'bg-primary',
                processing: 'bg-info text-dark',
                completed: 'bg-success',
                partial: 'bg-warning text-dark',
                failed: 'bg-danger',
                cancelled: 'bg-secondary',
            }

            function updateScheduleFields() {
                const media = scheduleType.value !== 'text'
                document
                    .getElementById('scheduleTextField')
                    .classList.toggle('d-none', media)
                document
                    .getElementById('scheduleMediaFields')
                    .classList.toggle('d-none', !media)
                document
                    .getElementById('scheduleCaptionField')
                    .classList.toggle('d-none', !media)
                document.getElementById('scheduleMessage').required = !media
                document.getElementById('scheduleUrl').required = media
            }
            scheduleType.addEventListener('change', updateScheduleFields)
            updateScheduleFields()

            function addCell(row, value, className = '') {
                const cell = document.createElement('td')
                cell.className = className
                cell.textContent = value
                row.append(cell)
                return cell
            }

            function statusBadge(status) {
                const badge = document.createElement('span')
                badge.className = `badge ${
                    stateClasses[status] || 'bg-secondary'
                }`
                badge.textContent = status
                return badge
            }

            function showNotice(type, message) {
                if (
                    window.toastr &&
                    typeof window.toastr[type] === 'function'
                ) {
                    window.toastr[type](message)
                } else {
                    window.alert(message)
                }
            }

            async function loadPlanLimits() {
                const response = await fetch('/manager/plan-summary')
                const result = await response.json()
                if (!response.ok || result.error)
                    throw new Error(result.message || 'Plan limits load nahi ho sake.')
                const plan = result.data
                maxRecipientsPerCampaign = plan.dailyMessageLimit
                    ? Math.min(plan.maxRecipientsPerCampaign, plan.dailyMessageLimit)
                    : plan.maxRecipientsPerCampaign
                const messages = plan.dailyMessageLimit
                    ? `${plan.dailyMessagesSent + plan.dailyMessagesReserved}/${plan.dailyMessageLimit} messages used today`
                    : 'no daily message cap'
                const contacts = plan.maxUniqueRecipients < 0
                    ? 'unlimited contacts'
                    : `${plan.uniqueRecipientsUsed}/${plan.maxUniqueRecipients} unique contacts used for this plan`
                document.getElementById('planLimitsNotice').textContent =
                    `${plan.name}: up to ${maxRecipientsPerCampaign} recipients per campaign; ${messages}; ${contacts}.`
            }

            function setEditingState(campaign) {
                editingCampaignId = campaign?._id || null
                document.getElementById('scheduleFormTitle').innerHTML =
                    editingCampaignId
                        ? '<i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Schedule'
                        : '<i class="fa-solid fa-calendar-plus text-success me-2"></i>New Schedule'
                const submit = document.getElementById('scheduleSubmit')
                submit.innerHTML = editingCampaignId
                    ? '<i class="fa-solid fa-floppy-disk me-1"></i> Save changes'
                    : '<i class="fa-solid fa-calendar-check me-1"></i> Schedule message'
                document
                    .getElementById('cancelScheduleEdit')
                    .classList.toggle('d-none', !editingCampaignId)
            }

            function cancelScheduleEdit() {
                scheduleForm.reset()
                setEditingState(null)
                updateScheduleFields()
            }

            async function editCampaign(id) {
                try {
                    const response = await fetch(
                        `/manager/scheduled-messages/${encodeURIComponent(id)}`
                    )
                    const result = await response.json()
                    if (!response.ok || result.error)
                        throw new Error(
                            result.message || 'Schedule details load nahi hue.'
                        )
                    const campaign = result.data
                    if (
                        campaign.status !== 'scheduled' ||
                        new Date(campaign.scheduledAt) <= new Date()
                    ) {
                        throw new Error(
                            'Sirf future scheduled message edit kiya ja sakta hai.'
                        )
                    }
                    document.getElementById('scheduleInstance').value =
                        campaign.tokenId
                    document.getElementById('scheduleAt').value = new Date(
                        new Date(campaign.scheduledAt).getTime() -
                            new Date().getTimezoneOffset() * 60000
                    )
                        .toISOString()
                        .slice(0, 16)
                    document.getElementById('scheduleType').value =
                        campaign.type
                    document.getElementById('scheduleNumbers').value =
                        campaign.recipients
                            .map((recipient) => recipient.number)
                            .join(', ')
