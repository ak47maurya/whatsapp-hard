                    if (editingTemplateScheduleId === id)
                        resetTemplateScheduleForm()
                    await loadTemplateSchedules()
                } catch (error) {
                    showNotice('error', error.message)
                }
            }

            async function loadTemplateSchedules() {
                const body = document.getElementById(
                    'templateScheduleTableBody'
                )
                try {
                    const response = await fetch(
                        '/manager/template-scheduled-messages'
                    )
                    const result = await response.json()
                    if (!response.ok || result.error)
                        throw new Error(
                            result.message ||
                                'Template schedules load nahi ho sake.'
                        )
                    body.replaceChildren()
                    if (!result.data.length) {
                        const row = body.insertRow()
                        const cell = row.insertCell()
                        cell.colSpan = 6
                        cell.className = 'text-center text-muted py-3'
                        cell.textContent =
                            'Abhi koi template schedule nahi hai.'
                        return
                    }
                    for (const campaign of result.data) {
                        const row = body.insertRow()
                        addCell(
                            row,
                            new Date(campaign.scheduledAt).toLocaleString()
                        )
                        addCell(row, campaign.templateName || 'Template')
                        addCell(row, campaign.tokenId, 'text-break')
                        addCell(
                            row,
                            `${campaign.counts.sent} sent / ${campaign.counts.failed} failed / ${campaign.counts.pending} pending`
                        )
                        const statusCell = row.insertCell()
                        statusCell.append(statusBadge(campaign.status))
                        const actions = row.insertCell()
                        actions.className = 'text-nowrap'
                        const detailsButton = document.createElement('button')
                        detailsButton.type = 'button'
                        detailsButton.className =
                            'btn btn-outline-primary btn-sm rounded-pill me-1'
                        detailsButton.textContent = 'Details'
                        detailsButton.addEventListener('click', () =>
                            showAnalytics(
                                campaign._id,
                                '/manager/template-scheduled-messages'
                            )
                        )
                        actions.append(detailsButton)
                        if (campaign.status === 'scheduled') {
                            const editButton = document.createElement('button')
                            editButton.type = 'button'
                            editButton.className =
                                'btn btn-outline-secondary btn-sm rounded-pill me-1'
                            editButton.textContent = 'Edit'
                            editButton.addEventListener('click', () =>
                                editTemplateSchedule(campaign._id)
                            )
                            actions.append(editButton)
                        }
                        if (campaign.status !== 'processing') {
                            const deleteButton =
                                document.createElement('button')
                            deleteButton.type = 'button'
                            deleteButton.className =
                                'btn btn-outline-danger btn-sm rounded-pill'
                            deleteButton.textContent = 'Delete'
                            deleteButton.addEventListener('click', () =>
                                deleteTemplateSchedule(campaign._id)
                            )
                            actions.append(deleteButton)
                        }
                    }
                } catch (error) {
                    body.replaceChildren()
                    const row = body.insertRow()
                    const cell = row.insertCell()
                    cell.colSpan = 6
                    cell.className = 'text-center text-danger py-3'
                    cell.textContent = error.message
                }
            }

            document
                .getElementById('refreshTemplateSchedules')
                .addEventListener('click', loadTemplateSchedules)
            }

            scheduleForm.addEventListener('submit', async (event) => {
                event.preventDefault()
                const button = document.getElementById('scheduleSubmit')
                button.disabled = true
                button.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Scheduling...'
                try {
                    const scheduledAt = new Date(
                        document.getElementById('scheduleAt').value
                    )
                    const payload = {
                        tokenId:
                            document.getElementById('scheduleInstance').value,
                        numbers:
                            document.getElementById('scheduleNumbers').value,
                        type: scheduleType.value,
                        scheduledAt: scheduledAt.toISOString(),
                        message:
                            document.getElementById('scheduleMessage').value,
                        url: document.getElementById('scheduleUrl').value,
                        caption:
                            document.getElementById('scheduleCaption').value,
                    }
                    const response = await fetch(
                        editingCampaignId
                            ? `/manager/scheduled-messages/${encodeURIComponent(
                                  editingCampaignId
                              )}`
                            : '/manager/scheduled-messages',
                        {
                            method: editingCampaignId ? 'PUT' : 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload),
                        }
                    )
                    const result = await response.json()
                    if (!response.ok || result.error)
                        throw new Error(
                            result.message || 'Message schedule nahi ho saka.'
                        )
                    showNotice(
                        'success',
                        editingCampaignId
                            ? 'Schedule update ho gaya.'
                            : 'Message schedule ho gaya.'
                    )
                    scheduleForm.reset()
                    setEditingState(null)
                    updateScheduleFields()
                    await loadCampaigns()
                } catch (error) {
                    showNotice(
                        'error',
                        error.message ||
                            'Date/time select karein aur valid schedule details enter karein.'
                    )
                } finally {
                    button.disabled = false
                    button.innerHTML = editingCampaignId
                        ? '<i class="fa-solid fa-floppy-disk me-1"></i> Save changes'
                        : '<i class="fa-solid fa-calendar-check me-1"></i> Schedule message'
                }
            })

            document.addEventListener('DOMContentLoaded', () => {
                loadPlanLimits().catch((error) => {
                    const notice = document.getElementById('planLimitsNotice')
                    notice.className = 'alert alert-danger py-2'
                    notice.textContent = error.message
                })
                const localNow = new Date(
                    Date.now() - new Date().getTimezoneOffset() * 60000
                )
                document.getElementById('scheduleAt').min = localNow
                    .toISOString()
                    .slice(0, 16)
                loadCampaigns()
                setInterval(loadCampaigns, 15000)
            })
        </script>
    </body>
</html>
