            function exportTemplateWorkbook(template) {
                if (!window.XLSX) {
                    showNotice(
                        'error',
                        'Excel browser library load nahi hui. Page reload karke dobara try karein.'
                    )
                    return
                }
                const workbook = XLSX.utils.book_new()
                const headers = ['mobile', ...template.variables]
                const sheet = XLSX.utils.aoa_to_sheet([headers])
                sheet['!cols'] = headers.map((header) => ({
                    wch: Math.max(18, header.length + 4),
                }))
                XLSX.utils.book_append_sheet(workbook, sheet, 'Recipients')
                const safeName =
                    template.name
                        .replace(/[^A-Za-z0-9_-]+/g, '-')
                        .replace(/^-|-$/g, '') || 'template'
                XLSX.writeFile(workbook, `${safeName}-recipients.xlsx`)
            }

            function normalizeSpreadsheetNumber(value) {
                if (typeof value === 'number' && Number.isFinite(value)) {
                    if (!Number.isSafeInteger(value)) return null
                    value = String(value)
                }
                if (!/^\+?[\d\s()-]+$/.test(String(value || ''))) return null
                const number = String(value).replace(/\D/g, '')
                return number.length >= 7 && number.length <= 15 ? number : null
            }

            async function readTemplateWorkbook(file, template) {
                if (!window.XLSX)
                    throw new Error(
                        'Excel browser library load nahi hui. Page reload karke dobara try karein.'
                    )
                if (!file || !/\.xlsx$/i.test(file.name))
                    throw new Error('Please .xlsx Excel file select karein.')
                if (file.size > 2 * 1024 * 1024)
                    throw new Error('Excel file 2 MB se chhoti honi chahiye.')
                let workbook
                try {
                    workbook = XLSX.read(await file.arrayBuffer(), {
                        type: 'array',
                        cellDates: false,
                    })
                } catch {
                    throw new Error(
                        'Excel file read nahi ho saki. Valid .xlsx workbook select karein.'
                    )
                }
                const firstSheet = workbook.SheetNames[0]
                if (!firstSheet)
                    throw new Error('Excel file mein worksheet nahi mili.')
                const rows = XLSX.utils.sheet_to_json(
                    workbook.Sheets[firstSheet],
                    {
                        header: 1,
                        defval: '',
                        raw: false,
                    }
                )
                if (!rows.length)
                    throw new Error('Excel file mein header row nahi hai.')

                const normalizeHeader = (value) =>
                    String(value || '')
                        .trim()
                        .toLowerCase()
                        .replace(/[^a-z0-9]/g, '')
                const headers = rows[0].map(normalizeHeader)
                const usedHeaders = headers.filter(Boolean)
                if (new Set(usedHeaders).size !== usedHeaders.length)
                    throw new Error(
                        'Excel file mein duplicate column headers hain.'
                    )
                const mobileColumn = headers.findIndex((header) =>
                    [
                        'mobile',
                        'mobilenumber',
                        'phone',
                        'phonenumber',
                        'number',
                        'contactnumber',
                    ].includes(header)
                )
                if (mobileColumn < 0)
                    throw new Error('Excel header mein mobile column nahi hai.')
                const variableColumns = new Map()
                for (const variable of template.variables) {
                    const column = headers.indexOf(normalizeHeader(variable))
                    if (column < 0)
                        throw new Error(
                            `Excel file mein "${variable}" column nahi mila.`
                        )
                    variableColumns.set(variable, column)
                }

                const dataRows = rows
                    .slice(1)
                    .filter((row) =>
                        row.some((value) => String(value ?? '').trim())
                    )
                if (!dataRows.length || dataRows.length > 500)
                    throw new Error(
                        'Excel file mein 1 se 500 recipient rows honi chahiye.'
                    )
                const seenNumbers = new Set()
                return dataRows.map((row, index) => {
                    const number = normalizeSpreadsheetNumber(row[mobileColumn])
                    if (!number)
                        throw new Error(
                            `Row ${
                                index + 2
                            }: country code ke saath valid mobile number enter karein.`
                        )
                    if (seenNumbers.has(number))
                        throw new Error(
                            `Row ${index + 2}: mobile number duplicate hai.`
                        )
                    seenNumbers.add(number)
                    const variables = {}
                    for (const [variable, column] of variableColumns) {
                        const value = String(row[column] ?? '').trim()
                        if (!value)
                            throw new Error(
                                `Row ${
                                    index + 2
                                }: "${variable}" blank nahi ho sakta.`
                            )
                        variables[variable] = value
                    }
                    const message = template.body.replace(
                        /{{\s*([A-Za-z][A-Za-z0-9_]*)\s*}}/g,
                        (_, key) => variables[key] || ''
                    )
                    if (message.length > 4000)
                        throw new Error(
                            `Row ${
                                index + 2
                            }: message 4,000 characters se bada hai.`
                        )
                    return { number, variables }
                })
            }

