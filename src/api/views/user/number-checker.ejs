<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WhatsApp Number Check — AK Automations</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="user-layout">
  <nav class="navbar navbar-expand-lg navbar-gold fixed-top shadow-sm">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/manager/dashboard">
        <span class="d-inline-flex align-items-center justify-content-center" style="width:38px;height:38px;border-radius:10px;background:#fff;color:var(--gold-dark);font-weight:800;">AK</span>
        <span>AK Automations</span>
      </a>
      <div class="d-flex align-items-center gap-3 ms-auto">
        <span class="text-white-50 small d-none d-md-inline">Welcome, <strong><%= user.username %></strong></span>
        <a class="btn btn-light btn-sm rounded-pill px-3 d-none d-md-inline-flex" href="/manager/logout"><i class="fa-solid fa-right-from-bracket me-1"></i> Logout</a>
        <button class="navbar-toggler d-lg-none" type="button" id="userSidebarToggle" aria-label="Open navigation menu" aria-controls="userSidebar" aria-expanded="false">
          <i class="fa-solid fa-bars text-white"></i>
        </button>
      </div>
    </div>
  </nav>

  <div class="user-sidebar-overlay" id="userSidebarOverlay"></div>
  <div class="container-fluid user-app">
    <div class="row gx-0">
      <nav class="col-md-3 col-lg-2 sidebar" id="userSidebar" aria-label="Main navigation">
        <div class="position-sticky pt-4 px-3">
          <div class="text-center mb-4 pb-3 border-bottom">
            <div class="d-inline-flex align-items-center justify-content-center mx-auto mb-2" style="width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,var(--gold-light),var(--gold));color:#fff;font-weight:800;font-size:1.25rem;">AK</div>
            <h6 class="mb-0 fw-bold text-uppercase small">User Panel</h6>
          </div>
          <%- include('partials/sidebar-navigation', { activePage: 'number-checker' }) %>
        </div>
      </nav>

      <main class="col-md-9 col-lg-10 px-3 px-md-4 py-4">
        <div class="pb-3 mb-4 border-bottom">
          <h2 class="fw-bold text-dark mb-1">WhatsApp Number Check</h2>
          <small class="text-muted">Numbers ko WhatsApp par check karke available aur unavailable lists dekhein.</small>
        </div>

        <section class="card border-0 shadow-sm rounded-4 mb-4">
          <div class="card-body p-3 p-md-4">
            <form id="numberCheckForm">
              <div class="mb-3">
                <label for="checkerInstance" class="form-label fw-semibold">WhatsApp instance</label>
                <select class="form-select" id="checkerInstance" required>
                  <option value="">Instance select karein</option>
                  <% (user.insdetails || []).forEach(instance => { %>
                    <option value="<%= instance.Token_Id %>"><%= instance.Token_Id %></option>
                  <% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label for="checkerNumbers" class="form-label fw-semibold">Mobile numbers</label>
                <textarea class="form-control" id="checkerNumbers" rows="4" placeholder="919876543210, 918765432109" required></textarea>
                <div class="form-text">Country code ke saath numbers comma ya new line se separate karein. Maximum 500 numbers.</div>
              </div>
              <button class="btn btn-success rounded-pill px-4" id="checkNumbersButton" type="submit">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Check numbers
              </button>
              <span class="ms-2 text-muted small" id="checkerStatus" role="status"></span>
            </form>
          </div>
        </section>

        <div class="row g-3">
          <div class="col-12 col-lg-6">
            <section class="card border-0 shadow-sm rounded-4 h-100">
              <div class="card-header bg-white border-0 pt-3 px-3 px-md-4">
                <h5 class="fw-bold text-success mb-0"><i class="fa-solid fa-circle-check me-2"></i>WhatsApp available <span class="badge bg-success ms-1" id="availableCount">0</span></h5>
              </div>
              <div class="card-body px-3 px-md-4">
                <ul class="list-group list-group-flush" id="availableList"><li class="list-group-item px-0 text-muted small">Abhi tak check nahi hua.</li></ul>
              </div>
            </section>
          </div>
          <div class="col-12 col-lg-6">
            <section class="card border-0 shadow-sm rounded-4 h-100">
              <div class="card-header bg-white border-0 pt-3 px-3 px-md-4">
                <h5 class="fw-bold text-danger mb-0"><i class="fa-solid fa-circle-xmark me-2"></i>WhatsApp unavailable <span class="badge bg-danger ms-1" id="unavailableCount">0</span></h5>
              </div>
              <div class="card-body px-3 px-md-4">
                <ul class="list-group list-group-flush" id="unavailableList"><li class="list-group-item px-0 text-muted small">Abhi tak check nahi hua.</li></ul>
              </div>
            </section>
          </div>
        </div>
        <%- include('partials/footer') %>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/user-navigation.js"></script>
  <script>
    const form = document.getElementById('numberCheckForm');
    const button = document.getElementById('checkNumbersButton');
    const status = document.getElementById('checkerStatus');

    function showNumbers(list, results, emptyText) {
      list.replaceChildren();
      if (!results.length) {
        const empty = document.createElement('li');
        empty.className = 'list-group-item px-0 text-muted small';
        empty.textContent = emptyText;
        list.append(empty);
        return;
      }
      results.forEach(result => {
        const item = document.createElement('li');
        item.className = 'list-group-item px-0 d-flex justify-content-between gap-2';
        const number = document.createElement('span');
        number.textContent = result.number;
        const jid = document.createElement('small');
        jid.className = 'text-muted text-break text-end';
        jid.textContent = result.jid || '';
        item.append(number, jid);
        list.append(item);
      });
    }

    form.addEventListener('submit', async event => {
      event.preventDefault();
      const tokenId = document.getElementById('checkerInstance').value;
      const numbers = document.getElementById('checkerNumbers').value;
      button.disabled = true;
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Checking...';
      status.textContent = 'Numbers check ho rahe hain...';
      try {
        const response = await fetch('/manager/number-checker', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tokenId, numbers }),
        });
        const result = await response.json();
        if (!response.ok || result.error) throw new Error(result.message || 'Number check complete nahi hua.');
        const available = result.data.available || [];
        const unavailable = result.data.unavailable || [];
        document.getElementById('availableCount').textContent = available.length;
        document.getElementById('unavailableCount').textContent = unavailable.length;
        showNumbers(document.getElementById('availableList'), available, 'Koi WhatsApp-available number nahi mila.');
        showNumbers(document.getElementById('unavailableList'), unavailable, 'Koi WhatsApp-unavailable number nahi mila.');
        status.textContent = `Check complete: ${result.data.total} unique numbers.`;
      } catch (error) {
        status.textContent = error.message || 'Number check karte waqt error aaya.';
      } finally {
        button.disabled = false;
        button.innerHTML = '<i class="fa-solid fa-magnifying-glass me-1"></i> Check numbers';
      }
    });
  </script>
</body>
</html>
