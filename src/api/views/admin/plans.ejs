<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage Plans — AK Automations</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="user-layout">
    <nav class="navbar navbar-expand-lg navbar-gold fixed-top shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-white" href="/manager/dashboard">AK Automations Admin</a>
            <div class="d-flex align-items-center gap-3 ms-auto">
                <span class="text-white-50 small d-none d-md-inline">Welcome, <strong><%= user.username %></strong></span>
                <a class="btn btn-light btn-sm rounded-pill px-3" href="/manager/logout">Logout</a>
            </div>
        </div>
    </nav>
    <main class="container py-5" style="padding-top: 6rem !important">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <div>
                <h1 class="h2 fw-bold">Plan editor</h1>
                <p class="text-muted mb-0">Plan changes update the public pricing page and assigned users' limits.</p>
            </div>
            <a class="btn btn-outline-secondary rounded-pill" href="/manager/dashboard">Back to admin dashboard</a>
        </div>
        <div class="row g-4">
            <div class="col-lg-5">
                <section class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-bold" id="planFormTitle">Create a plan</h2>
                        <form id="planForm" class="row g-3">
                            <input type="hidden" id="planId">
                            <div class="col-md-8">
                                <label class="form-label" for="planName">Plan name</label>
                                <input class="form-control" id="planName" maxlength="80" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="planPrice">Price (INR)</label>
                                <input class="form-control" id="planPrice" type="number" min="0" step="1" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="planDuration">Duration (days)</label>
                                <input class="form-control" id="planDuration" type="number" min="1" step="1" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="planInstances">Instances</label>
                                <input class="form-control" id="planInstances" type="number" min="1" step="1" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="dailyMessageLimit">Messages per day (0 = unlimited)</label>
                                <input class="form-control" id="dailyMessageLimit" type="number" min="0" step="1" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="maxUniqueRecipients">Unique contacts per plan (-1 = unlimited)</label>
                                <input class="form-control" id="maxUniqueRecipients" type="number" min="-1" step="1" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="campaignLimit">Recipients per campaign</label>
                                <input class="form-control" id="campaignLimit" type="number" min="1" step="1" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="planFeatures">Public feature list (one feature per line)</label>
                                <textarea class="form-control" id="planFeatures" rows="5" maxlength="4000"></textarea>
                            </div>
                            <div class="col-4 form-check ms-2">
                                <input class="form-check-input" id="planPublic" type="checkbox">
                                <label class="form-check-label" for="planPublic">Show publicly</label>
                            </div>
                            <div class="col-3 form-check">
                                <input class="form-check-input" id="planActive" type="checkbox">
                                <label class="form-check-label" for="planActive">Active</label>
                            </div>
                            <div class="col-3 form-check">
                                <input class="form-check-input" id="planFeatured" type="checkbox">
                                <label class="form-check-label" for="planFeatured">Featured</label>
                            </div>
                            <div class="col-12 d-flex gap-2">
                                <button class="btn btn-gold rounded-pill px-4" type="submit">Save plan</button>
                                <button class="btn btn-outline-secondary rounded-pill d-none" id="cancelEdit" type="button">Cancel edit</button>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
            <div class="col-lg-7">
                <section class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-bold">Configured plans</h2>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead><tr><th>Plan</th><th>Price</th><th>Limits</th><th>Visibility</th><th></th></tr></thead>
                                <tbody id="plansTable"><tr><td colspan="5" class="text-center text-muted">Loading plans…</td></tr></tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const form = document.getElementById('planForm');
        const plansTable = document.getElementById('plansTable');
        let plans = [];

        function notice(message) {
            window.alert(message);
        }

        function renderPlans() {
            plansTable.replaceChildren();
            plans.forEach((plan) => {
                const row = plansTable.insertRow();
                const name = row.insertCell();
                name.textContent = plan.name;
                const price = row.insertCell();
                price.textContent = `₹${Number(plan.price).toLocaleString('en-IN')} / ${plan.durationDays} days`;
                const limits = row.insertCell();
                limits.textContent = `${plan.manyInstance} devices · ${plan.dailyMessageLimit || '∞'} messages/day · ${plan.maxUniqueRecipients < 0 ? '∞' : plan.maxUniqueRecipients} contacts`;
                const visibility = row.insertCell();
                visibility.textContent = plan.active ? (plan.public ? 'Public' : 'Private') : 'Inactive';
                const action = row.insertCell();
                const edit = document.createElement('button');
                edit.className = 'btn btn-outline-primary btn-sm rounded-pill';
                edit.type = 'button';
                edit.textContent = 'Edit';
                edit.addEventListener('click', () => editPlan(plan));
                action.append(edit);
            });
        }

        async function loadPlans() {
            const response = await fetch('/manager/plans/data');
            const result = await response.json();
            if (!response.ok || result.error) throw new Error(result.message || 'Could not load plans.');
            plans = result.data;
            renderPlans();
        }

        function editPlan(plan) {
            document.getElementById('planId').value = plan._id;
            document.getElementById('planName').value = plan.name;
            document.getElementById('planPrice').value = plan.price;
            document.getElementById('planDuration').value = plan.durationDays;
            document.getElementById('planInstances').value = plan.manyInstance;
            document.getElementById('dailyMessageLimit').value = plan.dailyMessageLimit;
            document.getElementById('maxUniqueRecipients').value = plan.maxUniqueRecipients;
            document.getElementById('campaignLimit').value = plan.maxRecipientsPerCampaign;
            document.getElementById('planFeatures').value = (plan.features || []).join('\n');
            document.getElementById('planPublic').checked = plan.public;
            document.getElementById('planActive').checked = plan.active;
            document.getElementById('planFeatured').checked = plan.featured;
            document.getElementById('planFormTitle').textContent = `Edit ${plan.name}`;
            document.getElementById('cancelEdit').classList.remove('d-none');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            form.reset();
            document.getElementById('planId').value = '';
            document.getElementById('planFormTitle').textContent = 'Create a plan';
            document.getElementById('cancelEdit').classList.add('d-none');
            document.getElementById('planActive').checked = true;
            document.getElementById('planPublic').checked = true;
            document.getElementById('campaignLimit').value = 500;
            document.getElementById('maxUniqueRecipients').value = -1;
            document.getElementById('dailyMessageLimit').value = 0;
        }

        document.getElementById('cancelEdit').addEventListener('click', resetForm);
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const id = document.getElementById('planId').value;
            const payload = {
                name: document.getElementById('planName').value,
                price: Number(document.getElementById('planPrice').value),
                durationDays: Number(document.getElementById('planDuration').value),
                manyInstance: Number(document.getElementById('planInstances').value),
                dailyMessageLimit: Number(document.getElementById('dailyMessageLimit').value),
                maxUniqueRecipients: Number(document.getElementById('maxUniqueRecipients').value),
                maxRecipientsPerCampaign: Number(document.getElementById('campaignLimit').value),
                features: document.getElementById('planFeatures').value,
                public: document.getElementById('planPublic').checked,
                active: document.getElementById('planActive').checked,
                featured: document.getElementById('planFeatured').checked,
            };
            try {
                const response = await fetch(id ? `/manager/plans/${encodeURIComponent(id)}` : '/manager/plans', {
                    method: id ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                const result = await response.json();
                if (!response.ok || result.error) throw new Error(result.message || 'Could not save plan.');
                resetForm();
                await loadPlans();
                notice('Plan saved.');
            } catch (error) {
                notice(error.message);
            }
        });
        resetForm();
        loadPlans().catch((error) => {
            plansTable.innerHTML = '';
            const row = plansTable.insertRow();
            const cell = row.insertCell();
            cell.colSpan = 5;
            cell.className = 'text-center text-danger';
            cell.textContent = error.message;
        });
    </script>
</body>
</html>
