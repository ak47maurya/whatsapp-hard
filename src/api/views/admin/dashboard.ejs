<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard — AK Automations</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    :root {
      --gold: #c9a227;
      --gold-dark: #a9861d;
      --gold-light: #e6c65c;
      --gold-soft: #f7edd0;
      --gold-bg: #fdfaf1;
      --ink: #3a3222;
      --ink-soft: #6b6353;
      --line: #ecdfb8;
    }
    body { background: var(--gold-bg); color: var(--ink); font-family: 'Outfit', sans-serif; }
    .navbar-gold { background: linear-gradient(135deg, var(--gold-light), var(--gold)) !important; }
    .navbar-gold .navbar-brand { font-weight: 800; color: #fff !important; font-size: 1.1rem; }
    .navbar-gold .navbar-brand img { filter: brightness(0) invert(1); }
    .navbar-gold .nav-link { color: rgba(255,255,255,.9) !important; font-weight: 500; }
    .navbar-gold .nav-link:hover { color: #fff !important; }
    .sidebar { background: #fff; border-right: 1px solid var(--line); min-height: calc(100vh - 56px); position: sticky; top: 56px; height: calc(100vh - 56px); align-self: flex-start; }
    .sidebar .nav-link { color: var(--ink-soft); border-radius: 10px; margin: 2px 12px; font-weight: 500; transition: all .25s; }
    .sidebar .nav-link:hover { background: var(--gold-soft); color: var(--gold-dark); }
    .sidebar .nav-link.active { background: var(--gold-soft); color: var(--gold-dark); font-weight: 600; }
    .stat-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 8px 24px rgba(169,134,29,.08); transition: transform .2s, box-shadow .2s; }
    .stat-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(169,134,29,.15); }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.25rem; background: var(--gold-soft); color: var(--gold-dark); }
    .table-wrapper { background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    .table thead th { background: var(--gold-soft); color: var(--ink); border-bottom: 2px solid var(--line); font-weight: 600; }
    .table tbody tr:hover { background: var(--gold-soft); }
    .btn-gold { background: linear-gradient(135deg, var(--gold-light), var(--gold)); border: none; color: #fff; font-weight: 600; border-radius: 50px; box-shadow: 0 6px 18px rgba(169,134,29,.3); }
    .btn-gold:hover { color: #fff; filter: brightness(1.05); }
    .btn-outline-gold { border: 1.5px solid var(--gold); color: var(--gold-dark); background: transparent; font-weight: 600; border-radius: 50px; }
    .btn-outline-gold:hover { background: var(--gold); color: #fff; }
    .modal-content { border: 1px solid var(--line); border-radius: 16px; }
    .modal-header { background: var(--gold-soft); border-bottom: 1px solid var(--line); border-radius: 16px 16px 0 0; }
    .modal-title { color: var(--ink); font-weight: 700; }
    .form-control, .form-select { border: 1px solid var(--line); border-radius: 10px; background: #fffdf7; }
    .form-control:focus, .form-select:focus { border-color: var(--gold); box-shadow: 0 0 0 .2rem rgba(201,162,39,.15); }
    label { color: var(--ink); font-weight: 600; }
    .footer-admin { background: #fff; border-top: 1px solid var(--line); color: var(--ink-soft); }
    .sidebar-overlay { display: none; }
    @media (max-width: 991.98px) {
      .sidebar { position: fixed; top: 56px; left: 0; width: min(250px, 85vw); height: calc(100vh - 56px); min-height: 0; z-index: 1030; transform: translateX(-100%); transition: transform .3s; box-shadow: 0 8px 30px rgba(0,0,0,.1); }
      .sidebar.show { transform: translateX(0); }
      .sidebar-overlay { position: fixed; top: 56px; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.4); z-index: 1020; }
      .sidebar-overlay.show { display: block; }
      .container-fluid > .row > main { flex: 0 0 100%; max-width: 100%; }
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-gold fixed-top shadow-sm">
    <div class="container-fluid px-4">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/manager/dashboard">
        <span class="d-inline-flex align-items-center justify-content-center" style="width:38px;height:38px;border-radius:10px;background:#fff;color:var(--gold-dark);font-weight:800;font-size:1rem;">AK</span>
        <span>AK Automations Admin</span>
      </a>
      <div class="d-flex align-items-center gap-3 ms-auto">
        <span class="text-white-50 small d-none d-md-inline">Welcome, <strong><%= user.username %></strong></span>
        <div class="btn-group">
          <button class="btn btn-light btn-sm dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fa-solid fa-user-gear me-1"></i> Admin
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/manager/settings"><i class="fa-solid fa-gear me-2"></i> Settings</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item text-danger" href="/manager/logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Logout</a></li>
          </ul>
        </div>
        <button class="btn btn-light btn-sm d-lg-none rounded-pill px-3" type="button" id="sidebarToggle">
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>
    </div>
  </nav>

  <!-- Sidebar Overlay (mobile) -->
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="container-fluid mt-5 pt-2">
    <div class="row">
      <!-- Sidebar -->
      <nav class="col-md-3 col-lg-2 sidebar" id="sidebar">
        <div class="position-sticky pt-4 px-3" style="height: calc(100vh - 56px);">
          <div class="text-center mb-4 pb-3 border-bottom">
            <div class="d-inline-flex align-items-center justify-content-center mx-auto mb-2" style="width:50px;height:50px;border-radius:12px;background:linear-gradient(135deg,var(--gold-light),var(--gold));color:#fff;font-weight:800;font-size:1.25rem;">AK</div>
            <h6 class="mb-0 fw-bold text-uppercase text-gold small">Admin Panel</h6>
          </div>
          <ul class="nav flex-column">
            <li class="nav-item">
              <a class="nav-link active" href="/manager/dashboard">
                <i class="fa-solid fa-gauge-high me-2"></i> Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/manager/settings">
                <i class="fa-solid fa-gear me-2"></i> Settings
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/manager/reports">
                <i class="fa-solid fa-chart-line me-2"></i> Reports
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/manager/helps">
                <i class="fa-solid fa-circle-question me-2"></i> Help
              </a>
            </li>
            <li class="nav-item mt-3">
              <a class="nav-link text-danger" href="/manager/logout">
                <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
              </a>
            </li>
          </ul>
        </div>
      </nav>

      <!-- Main Content -->
      <main class="col-md-9 col-lg-10 px-3 px-md-4">
        <div class="d-flex justify-content-between flex-wrap align-items-center py-3 mb-4 border-bottom">
          <h1 class="h2 mb-0 fw-bold"><i class="fa-solid fa-gauge-high me-2 text-gold"></i>Admin Dashboard</h1>
          <div class="d-flex gap-2">
            <a class="btn btn-outline-gold btn-sm" href="/manager/plans"><i class="fa-solid fa-tags me-1"></i> Manage Plans</a>
            <button class="btn btn-gold btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#newUserModal"><i class="fa-solid fa-user-plus me-1"></i> Create User</button>
          </div>
        </div>

        <!-- Stats Row -->
        <div class="row g-3 mb-4" id="statsRow">
          <div class="col-6 col-md-3">
            <div class="stat-card p-3 text-center">
              <div class="stat-icon mb-2"><i class="fa-solid fa-users"></i></div>
              <div class="fw-bold fs-4 text-gold-dark" id="statTotalUsers">0</div>
              <div class="text-muted small">Total Users</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="stat-card p-3 text-center">
              <div class="stat-icon mb-2"><i class="fa-solid fa-user-check"></i></div>
              <div class="fw-bold fs-4 text-primary" id="statActiveUsers">0</div>
              <div class="text-muted small">Active Users</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="stat-card p-3 text-center">
              <div class="stat-icon mb-2"><i class="fa-solid fa-mobile-screen-button"></i></div>
              <div class="fw-bold fs-4 text-success" id="statTotalInstances">0</div>
              <div class="text-muted small">Total Instances</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="stat-card p-3 text-center">
              <div class="stat-icon mb-2"><i class="fa-solid fa-coins"></i></div>
              <div class="fw-bold fs-4 text-warning" id="statTrialUsers">0</div>
              <div class="text-muted small">On Trial</div>
            </div>
          </div>
        </div>

        <!-- Users Table -->
        <div class="table-wrapper">
          <div class="table-responsive">
            <table class="table table-hover mb-0" id="dataTable" style="width:100%">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Username</th>
                  <th scope="col">Email</th>
                  <th scope="col">Role</th>
                  <th scope="col">Instances</th>
                  <th scope="col">Start Date</th>
                  <th scope="col">End Date</th>
                  <th scope="col">Plan Status</th>
                  <th scope="col">Plan Type</th>
                  <th scope="col" class="text-center">Actions</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

      </main>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer-admin py-3 mt-auto">
    <div class="container-fluid text-center small">
      &copy; 2026 AK Automations. All Rights Reserved.
    </div>
  </footer>

  <!-- Edit User Modal -->
  <div class="modal fade" id="editDiv" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fa-solid fa-user-pen me-2"></i>Edit User</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="editForm">
          <div class="modal-body row g-3 p-4">
            <input type="hidden" id="editUserId">
            <div class="col-md-6">
              <label class="form-label">Username</label>
              <input type="text" class="form-control" id="username" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" id="email" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Role</label>
              <select class="form-select" id="role" required>
                <option value="user">User</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Instances</label>
              <input type="number" class="form-control" id="manyInstance" min="1" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Plan Status</label>
              <select class="form-select" id="planStatus" required>
                <option value="Trial">Trial</option>
                <option value="Active">Active</option>
                <option value="Expired">Expired</option>
                <option value="Suspended">Suspended</option>
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label">Assigned Plan</label>
              <select class="form-select" id="assignedPlanId" required></select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Plan Type</label>
              <input type="text" class="form-control" id="planType" readonly required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Start Date</label>
              <input type="date" class="form-control" id="startDate" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">End Date</label>
              <input type="date" class="form-control" id="endDate" required>
            </div>
          </div>
          <div class="modal-footer border-0 p-3">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-gold">Save Changes</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Create User Modal -->
  <div class="modal fade" id="newUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="fa-solid fa-user-plus me-2"></i>Create New User</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="newUserForm">
          <div class="modal-body row g-3 p-4">
            <div class="col-md-6">
              <label class="form-label">Username</label>
              <input type="text" class="form-control" id="newUsername" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" id="newEmail" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Password</label>
              <input type="password" class="form-control" id="newPassword" required minlength="6">
            </div>
            <div class="col-md-6">
              <label class="form-label">Role</label>
              <select class="form-select" id="newRole" required>
                <option value="user">User</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Instances</label>
              <input type="number" class="form-control" id="newManyInstance" min="1" value="1" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Plan Status</label>
              <select class="form-select" id="newPlanStatus" required>
                <option value="Trial">Trial</option>
                <option value="Active">Active</option>
                <option value="Expired">Expired</option>
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label">Assigned Plan</label>
              <select class="form-select" id="newAssignedPlanId" required></select>
            </div>
            <div class="col-md-4">
              <label class="form-label">Plan Type</label>
              <input type="text" class="form-control" id="newPlanType" value="2-Day Free Trial" readonly required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Start Date</label>
              <input type="date" class="form-control" id="newStartDate" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">End Date</label>
              <input type="date" class="form-control" id="newEndDate" required>
            </div>
          </div>
          <div class="modal-footer border-0 p-3">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-gold">Create User</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
  <script>
    // Sidebar toggle for mobile
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const toggle = document.getElementById('sidebarToggle');
    if (toggle) {
      toggle.addEventListener('click', () => {
        sidebar.classList.toggle('show');
        overlay.classList.toggle('show');
      });
      overlay.addEventListener('click', () => {
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
      });
    }

    // Format date for input
    function formatToDateInput(dateString) {
      if (!dateString) return '';
      const d = new Date(dateString);
      return d.toISOString().split('T')[0];
    }

    // Format date for display
    function formatDateDisplay(dateString) {
      if (!dateString) return '-';
      const d = new Date(dateString);
      return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
    }

    let availablePlans = [];
    async function loadPlans() {
      const response = await fetch('/manager/plans/data');
      const result = await response.json();
      if (!response.ok || result.error) throw new Error(result.message || 'Failed to load plans');
      availablePlans = result.data.filter(plan => plan.active);
      for (const id of ['assignedPlanId', 'newAssignedPlanId']) {
        const select = document.getElementById(id);
        select.replaceChildren();
        availablePlans.forEach(plan => {
          const option = document.createElement('option');
          option.value = plan._id;
          option.textContent = plan.name;
          select.append(option);
        });
      }
      if (!availablePlans.length) throw new Error('Create an active plan before assigning users.');
      const trial = availablePlans.find(plan => plan.slug === 'trial');
      document.getElementById('newAssignedPlanId').value = (trial || availablePlans[0])._id;
      if (!document.getElementById('newStartDate').value) {
        document.getElementById('newStartDate').value = new Date().toISOString().slice(0, 10);
      }
      syncPlanFields('newAssignedPlanId', 'newPlanType', 'newManyInstance', 'newStartDate', 'newEndDate', true);
    }

    function syncPlanFields(selectId, nameId, instanceId, startId, endId, setDates) {
      const plan = availablePlans.find(item => item._id === document.getElementById(selectId).value);
      if (!plan) return;
      document.getElementById(nameId).value = plan.name;
      document.getElementById(instanceId).value = plan.manyInstance;
      const startInput = document.getElementById(startId);
      const endInput = document.getElementById(endId);
      if (setDates && startInput.value) {
        const end = new Date(`${startInput.value}T00:00:00`);
        end.setDate(end.getDate() + plan.durationDays);
        const month = String(end.getMonth() + 1).padStart(2, '0');
        const day = String(end.getDate()).padStart(2, '0');
        endInput.value = `${end.getFullYear()}-${month}-${day}`;
      }
    }

    document.getElementById('assignedPlanId').addEventListener('change', () => {
      syncPlanFields('assignedPlanId', 'planType', 'manyInstance', 'startDate', 'endDate', false);
    });
    document.getElementById('newAssignedPlanId').addEventListener('change', () => {
      syncPlanFields('newAssignedPlanId', 'newPlanType', 'newManyInstance', 'newStartDate', 'newEndDate', true);
    });
    document.getElementById('newStartDate').addEventListener('change', () => {
      syncPlanFields('newAssignedPlanId', 'newPlanType', 'newManyInstance', 'newStartDate', 'newEndDate', true);
    });

    // Populate edit modal
    window.openEdit = function(userId) {
      const row = window.tableData?.find(user => String(user._id) === String(userId));
      if (!row) return;
      document.getElementById('editUserId').value = row._id;
      document.getElementById('username').value = row.username || '';
      document.getElementById('email').value = row.email || '';
      document.getElementById('role').value = row.role?.[0] || 'user';
      document.getElementById('manyInstance').value = row.manyInstance || 1;
      document.getElementById('startDate').value = formatToDateInput(row.startDate);
      document.getElementById('endDate').value = formatToDateInput(row.endDate);
      document.getElementById('planStatus').value = row.planStatus || 'Trial';
      document.getElementById('planType').value = row.planType || '';
      const assignedPlan = availablePlans.find(plan =>
        String(plan._id) === String(row.planId?._id || row.planId)
      ) || availablePlans.find(plan =>
        String(row.planType || '').toLowerCase().includes(plan.name.toLowerCase())
      ) || (row.planStatus === 'Trial' ? availablePlans.find(plan => plan.slug === 'trial') : null);
      if (assignedPlan) document.getElementById('assignedPlanId').value = assignedPlan._id;
      syncPlanFields('assignedPlanId', 'planType', 'manyInstance', 'startDate', 'endDate', false);
      new bootstrap.Modal(document.getElementById('editDiv')).show();
    };

    // Delete user
    window.deleteRow = function(userId) {
      const row = window.tableData?.find(user => String(user._id) === String(userId));
      if (!row) return;
      if (!confirm('Delete this user? This action cannot be undone.')) return;
      fetch(`/manager/users/${row._id}`, { method: 'DELETE' })
        .then(r => {
          if (!r.ok) throw new Error('Failed to delete user');
          return r.json();
        })
        .then(() => { loadUsers(); toastr.success('User deleted'); })
        .catch(error => {
          console.error('Delete user error:', error);
          toastr.error('Delete failed');
        });
    };

    // Load users into DataTable
    async function loadUsers() {
      try {
        const res = await fetch('/manager/users');
        if (!res.ok) throw new Error('Failed to fetch users');
        const users = await res.json();
        if (!Array.isArray(users)) throw new Error('Invalid users response');
        window.tableData = users;

        if ($.fn.DataTable.isDataTable('#dataTable')) {
          $('#dataTable').DataTable().destroy();
        }

        $('#dataTable').DataTable({
          data: users,
          columns: [
            { data: null, render: (d, t, r, meta) => meta.row + meta.settings._iDisplayStart + 1 },
            { data: 'username' },
            { data: 'email' },
            { data: null, render: d => Array.isArray(d.role) ? d.role.join(', ') : d.role },
            { data: 'manyInstance' },
            { data: 'startDate', render: d => formatDateDisplay(d) },
            { data: 'endDate', render: d => formatDateDisplay(d) },
            { data: 'planStatus', render: s => `<span class="badge bg-${s==='Active'?'success':s==='Trial'?'warning text-dark':s==='Expired'?'danger':'secondary'}">${s}</span>` },
            { data: 'planType' },
            { data: null, className: 'text-center', orderable: false, searchable: false, render: (d, t, row) => `
                <button class="btn btn-sm btn-outline-gold me-1" data-user-action="edit" data-user-id="${row._id}" title="Edit" aria-label="Edit user"><i class="fa-solid fa-pen"></i></button>
                <button class="btn btn-sm btn-outline-danger" data-user-action="delete" data-user-id="${row._id}" title="Delete" aria-label="Delete user"><i class="fa-solid fa-trash"></i></button>
              ` }
          ],
          pageLength: 10,
          order: [[0, 'asc']],
          language: { search: '', searchPlaceholder: 'Search users...' }
        });

        // Update stats
        const total = users.length;
        const active = users.filter(u => u.planStatus === 'Active').length;
        const trial = users.filter(u => u.planStatus === 'Trial').length;
        const instances = users.reduce((sum, u) => sum + (u.manyInstance || 0), 0);
        document.getElementById('statTotalUsers').textContent = total;
        document.getElementById('statActiveUsers').textContent = active;
        document.getElementById('statTotalInstances').textContent = instances;
        document.getElementById('statTrialUsers').textContent = trial;

      } catch (e) {
        console.error('Load users error:', e);
        toastr.error('Failed to load users');
      }
    }

    document.querySelector('#dataTable tbody').addEventListener('click', event => {
      const button = event.target.closest('button[data-user-action]');
      if (!button) return;
      if (button.dataset.userAction === 'edit') openEdit(button.dataset.userId);
      if (button.dataset.userAction === 'delete') deleteRow(button.dataset.userId);
    });

    // Create user form submit
    document.getElementById('newUserForm')?.addEventListener('submit', async e => {
      e.preventDefault();
      const data = {
        username: document.getElementById('newUsername').value,
        email: document.getElementById('newEmail').value,
        password: document.getElementById('newPassword').value,
        role: [document.getElementById('newRole').value],
        planId: document.getElementById('newAssignedPlanId').value,
        manyInstance: parseInt(document.getElementById('newManyInstance').value) || 1,
        startDate: document.getElementById('newStartDate').value,
        endDate: document.getElementById('newEndDate').value,
        planStatus: document.getElementById('newPlanStatus').value,
        planType: document.getElementById('newPlanType').value
      };
      try {
        const res = await fetch('/manager/addNewUsers', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
        if (!res.ok) throw new Error('Failed');
        bootstrap.Modal.getInstance(document.getElementById('newUserModal')).hide();
        document.getElementById('newUserForm').reset();
        loadUsers();
        toastr.success('User created');
      } catch { toastr.error('Create failed'); }
    });

    // Edit user form submit
    document.getElementById('editForm')?.addEventListener('submit', async e => {
      e.preventDefault();
      const id = document.getElementById('editUserId').value;
      const data = {
        username: document.getElementById('username').value,
        email: document.getElementById('email').value,
        role: [document.getElementById('role').value],
        planId: document.getElementById('assignedPlanId').value,
        manyInstance: parseInt(document.getElementById('manyInstance').value) || 1,
        startDate: document.getElementById('startDate').value,
        endDate: document.getElementById('endDate').value,
        planStatus: document.getElementById('planStatus').value,
        planType: document.getElementById('planType').value
      };
      try {
        const res = await fetch(`/manager/users/${id}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
        if (!res.ok) throw new Error('Failed');
        bootstrap.Modal.getInstance(document.getElementById('editDiv')).hide();
        loadUsers();
        toastr.success('User updated');
      } catch { toastr.error('Update failed'); }
    });

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      loadPlans().catch(error => {
        console.error('Load plans error:', error);
        toastr.error(error.message);
      });
      loadUsers();
    });
  </script>
</body>
</html>