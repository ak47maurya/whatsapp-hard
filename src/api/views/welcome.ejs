        <div class="row gy-4" data-aos="fade-left">
          <% const planImages = { basic: 'pricing-free.png', starter: 'pricing-starter.png', business: 'pricing-business.png', ultimate: 'pricing-ultimate.png' }; %>
          <% const planColors = ['#07d5c0', '#65c600', '#ff901c', '#ff0071']; %>
          <% (plans || []).forEach((plan, index) => { %>
            <div class="col-lg-3 col-md-6" data-aos="zoom-in" data-aos-delay="<%= (index + 1) * 100 %>">
              <div class="box">
                <% if (plan.featured) { %><span class="featured">Featured</span><% } %>
                <h3 style="color: <%= planColors[index % planColors.length] %>;"><%= plan.name %></h3>
                <div class="price"><sup>₹</sup><%= Number(plan.price).toLocaleString('en-IN') %><span> / <%= plan.durationDays === 30 ? 'mo' : `${plan.durationDays} days` %></span></div>
                <img src="/assets/img/<%= planImages[plan.slug] || 'pricing-free.png' %>" class="img-fluid" alt="<%= plan.name %>">
                <ul>
                  <li><%= plan.manyInstance %> WhatsApp instance<%= plan.manyInstance === 1 ? '' : 's' %></li>
                  <li><%= plan.dailyMessageLimit ? `${plan.dailyMessageLimit} messages per day` : 'No daily message cap' %></li>
                  <li><%= plan.maxUniqueRecipients < 0 ? 'Unlimited unique contacts' : `${plan.maxUniqueRecipients} unique contacts per plan term` %></li>
                  <li>Up to <%= plan.maxRecipientsPerCampaign %> recipients per campaign</li>
                  <% (plan.features || []).forEach(feature => { %><li><%= feature %></li><% }) %>
                </ul>
                <a href="https://wa.me/918299854822?text=<%= encodeURIComponent(`Hello, I am interested in the ${plan.name} for ₹${plan.price}.`) %>" class="btn-buy">Contact us</a>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
     
   
