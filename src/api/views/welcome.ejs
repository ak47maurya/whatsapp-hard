  <script>
    document.querySelectorAll('.copy-promo').forEach((button) => {
      button.addEventListener('click', async () => {
        const card = button.closest('.promo-card');
        const message = card.querySelector('.promo-copy').innerText.trim();
        const status = card.querySelector('.copy-status');

        if (!navigator.clipboard || !window.isSecureContext) {
          status.textContent = 'Clipboard access requires a secure connection. Select the message and copy it manually.';
          return;
        }

        try {
          await navigator.clipboard.writeText(message);
          status.textContent = 'Message copied. Personalize it before sending.';
        } catch (error) {
          console.error('Unable to copy promotional message:', error);
          status.textContent = 'Could not copy the message. Select it and copy manually.';
        }
      });
    });
  </script>

